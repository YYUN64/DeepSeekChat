<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".MarkdownPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.DeepSeekChat" />

        <!-- debug 包额外给一个桌面入口，方便不看 adb 也能确认公式到底渲染出来没有 -->
        <activity-alias
            android:name=".MathPreviewAlias"
            android:targetActivity=".MarkdownPreviewActivity"
            android:exported="true"
            android:label="公式预览（debug）">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
